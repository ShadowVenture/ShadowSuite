*wallet*.txt
*wallet*.dat
*.wallet
wallet*/
*seed*phrase*
*seed*.txt
*mnemonic*
*recovery*phrase*
*backup*.json
*backup*.txt
*.dat
keystore/
*ledger-live*
ledger*/
*trezor*
*bcvault*
*bc-vault*

# ---------------------------------------------------------------
# Runtime data, logs, databases
# Directory rules are anchored to the repo root ("/data/"), otherwise they would also
# swallow source packages with a data/ subpackage. File-type rules below
# (*.duckdb, *.parquet, ...) still apply everywhere.
# ---------------------------------------------------------------
/data/
/runtime/
/logs/
*.log
*.log.*
*.sqlite
*.sqlite3
*.db
*.duckdb
*.duckdb.wal
*.parquet
*.feather
*.arrow
*.csv.gz
/backtests/results/
/reports/
/diagnostics/
*.dump

